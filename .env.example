# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret: server and GitHub Actions only

# ---- Only these emails can log in (comma separated) ----
ALLOWED_EMAILS=you@example.com,wife@example.com

# ---- AI providers (order = fallback order) ----
AI_PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-27b-it:free

# ---- Password for the scheduled jobs (make up a long random string) ----
CRON_SECRET=
